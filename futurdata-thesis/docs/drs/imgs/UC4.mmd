sequenceDiagram
    actor User
    participant Win as MainWindow
    participant Ctrl as AppController
    participant Import as ProjectArchiveService / EnhancedJSONExporter
    participant Canvas as DiagramCanvas

    User->>Win: select Import Project...
    Win->>Ctrl: import_diagram_enhanced()
    Ctrl->>Win: check unsaved changes
    Ctrl->>Win: ask_file_path(save=False)
    Win-->>Ctrl: file_path
    Ctrl->>Import: import ZIP or supported diagram JSON
    Import-->>Ctrl: Diagram
    Ctrl->>Ctrl: detach imported IDs and persist independent project
    Ctrl->>Canvas: update_scroll_region_from_shapes(shapes)
    Ctrl->>Canvas: redraw_all(diagram)
    Ctrl->>Win: set_status("Imported project: ...")
